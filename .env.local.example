# Copia este archivo como .env.local y complétalo con tus datos.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# --- IA (Gemini, solo servidor) ---
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-flash-lite-latest
AI_API_KEY=TU_GEMINI_API_KEY

# ------------------------------------------------------------------
# Admin (panel /admin) y robot de alertas — todas de servidor (secretas)
# ------------------------------------------------------------------
# service_role de Supabase (Project Settings -> API). Permite actualizar la base.
SUPABASE_SERVICE_ROLE_KEY=
# correos (separados por coma) que pueden entrar al panel /admin
ADMIN_EMAILS=tu@correo.com
# texto largo para proteger el cron del robot de alertas
CRON_SECRET=
# (opcional) fuente que revisa el robot de resoluciones
RESOLUCIONES_URL=
